eady = self.ready@;"}, {"highlight_end": 47, "highlight_start": 1, "text": "        let ghost pre_head = self.head as int;"}, {"highlight_end": 44, "highlight_start": 1, "text": "        let module = self.ready[self.head];"}, {"highlight_end": 16, "highlight_start": 1, "text": "        proof {"}, {"highlight_end": 70, "highlight_start": 1, "text": "            // queue-readiness: the popped module is fully unblocked,"}, {"highlight_end": 67, "highlight_start": 1, "text": "            // so every dependency finished (the exact-count link)"}, {"highlight_end": 51, "highlight_start": 1, "text": "            assert(!self.started@[module as int]);"}, {"highlight_end": 57, "highlight_start": 1, "text": "            assert(self.remaining@[module as int] == 0);"}, {"highlight_end": 85, "highlight_start": 1, "text": "            lemma_unfinished_count_zero(self.deps@[module as int]@, self.finished@);"}, {"highlight_end": 10, "highlight_start": 1, "text": "        }"}, {"highlight_end": 24, "highlight_start": 1, "text": "        self.head += 1;"}, {"highlight_end": 37, "highlight_start": 1, "text": "        self.started[module] = true;"}, {"highlight_end": 16, "highlight_start": 1, "text": "        proof {"}, {"highlight_end": 71, "highlight_start": 1, "text": "            // the entry readiness clause, restated over the snapshots"}, {"highlight_end": 79, "highlight_start": 1, "text": "            assert(forall|i: int| #![trigger pre_started[i], pre_remaining[i]]"}, {"highlight_end": 61, "highlight_start": 1, "text": "                0 <= i < self.deps@.len() && !pre_started[i]"}, {"highlight_end": 61, "highlight_start": 1, "text": "                    && pre_remaining[i] == 0 && !self.failed"}, {"highlight_end": 54, "highlight_start": 1, "text": "                ==> pre_queued.contains(i as usize));"}, {"highlight_end": 44, "highlight_start": 1, "text": "            // the popped module was queued"}, {"highlight_end": 53, "highlight_start": 1, "text": "            assert(pre