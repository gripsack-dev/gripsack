SCRIPT_SHA256=cb4d0c09612cedd4f5c0c251e509f3942da714def3a8323933bff4f069eae0ad
import json
import os
from pathlib import Path
import shutil
import subprocess
import tempfile

with tempfile.TemporaryDirectory(prefix="gripsack-gc-prune-") as temporary:
    root = Path(temporary)
    repo = root / "repo"
    home = root / "state"
    (repo / "hosts").mkdir(parents=True)
    (repo / "env.toml").write_text('[env]\nname="gc-prune-smoke"\n')
    (repo / "hosts/testhost.ts").write_text('import { defineEnv, module, symlink } from "@gripsack/core";\nexport default defineEnv(() => ({modules:[module("demo",{install:{payload:symlink("~/.owned")}})]}));\n')
    env = dict(os.environ, HOME=str(root), GRIPSACK_HOME=str(home), GRIPSACK_TRUST_ALL="1", NO_COLOR="1")
    def run(arguments, extra=None):
        result = subprocess.run(["grip", *arguments], cwd=repo, env={**env, **(extra or {})}, capture_output=True, text=True, timeout=30)
        print("$ grip " + " ".join(arguments), "exit=" + str(result.returncode))
        print(result.stdout + result.stderr)
        return result
    for text in ["one", "two"]:
        (repo / "payload").write_text(text)
        assert run(["apply", "--host", "testhost"]).returncode == 0
    previous = (home / "current").readlink()
    generation = home / "generations/1"
    manifest = json.loads((generation / "manifest.json").read_text())
    payload = Path(manifest["modules"]["demo"]["store_path"])
    saved_generation, saved_payload = root / "saved-generation", root / "saved-payload"
    shutil.copytree(generation, saved_generation, symlinks=True)
    shutil.copytree(payload, saved_payload, symlinks=True)
    (repo / "env.toml").write_text('[env]\nname="gc-prune-smoke"\n[settings]\nkeep_generations=1\n')
    trace = root / "boundaries.tsv"
    def calibrate():
        trace.unlink(missing_ok=True)
        assert run(["gc"], {"GRIPSACK_FS_TRACE": str(trace)}).returncode == 0
        rows = [line.split("\t", 3) for line in trace.read_text().splitlines()]
        return next(row[0] for row in rows if row[1:] == ["Before", "DirSync", '"generations"'])
    def refuse(cut):
        result = run(["gc"], {"GRIPSACK_FS_CUT": cut, "GRIPSACK_FS_FAULT": "error"})
        assert result.returncode != 0
        assert not generation.exists()
        assert (payload / "payload").read_text() == "one"
        assert (home / "current").readlink() == previous
        assert (root / ".owned").read_text() == "two"
    prune_cut = calibrate()
    shutil.copytree(saved_generation, generation, symlinks=True)
    shutil.copytree(saved_payload, payload, symlinks=True)
    refuse(prune_cut)
    empty_cut = calibrate()
    shutil.copytree(saved_payload, payload, symlinks=True)
    refuse(empty_cut)
    assert run(["gc"]).returncode == 0
    assert not payload.exists()
    assert (root / ".owned").read_text() == "two"
    print('GC_PRUNE_SMOKE={"prune_failure_preserved_payload":true,"empty_retry_failure_preserved_payload":true,"current_preserved":true,"retry_collected_orphan":true,"power_loss_claim":false,"fuzz":"not_run"}')
