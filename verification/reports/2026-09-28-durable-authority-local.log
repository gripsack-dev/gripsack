SCRIPT_SHA256=73496952ea54df7d6376cd575914b9cf671ff309f3e67e2f367b10706cc72d40
import hashlib
import json
import os
from pathlib import Path
import signal
import subprocess
import tempfile

with tempfile.TemporaryDirectory(prefix="gripsack-retained-prior-") as temporary:
    root = Path(temporary)
    repo, home = root / "repo", root / "state"
    (repo / "hosts").mkdir(parents=True)
    (repo / "env.toml").write_text('[env]\nname="retained-prior-smoke"\n')
    (repo / "hosts/testhost.ts").write_text('import { defineEnv, module } from "@gripsack/core";\nexport default defineEnv(() => ({modules:[module("demo",{})]}));\n')
    env = dict(os.environ, HOME=str(root), GRIPSACK_HOME=str(home), GRIPSACK_TRUST_ALL="1", GRIPSACK_FS_RECOVER_ONLY="1", NO_COLOR="1")
    def run(extra=None):
        result = subprocess.run(["grip", "apply", "--host", "testhost"], cwd=repo, env={**env, **(extra or {})}, capture_output=True, text=True, timeout=30)
        print("$ grip apply --host testhost", "exit=" + str(result.returncode))
        print(result.stdout + result.stderr)
        return result
    assert run().returncode == 0
    (home / "journal").mkdir(mode=0o700, exist_ok=True)
    (home / "prior").mkdir(mode=0o700)
    original = b"retained recovery bytes\n"
    blob = home / "prior" / hashlib.sha256(original).hexdigest()
    blob.write_bytes(original)
    blob.chmod(0o600)
    destination = root / "interrupted"
    prior = {"kind": "file", "hash": blob.name, "mode": 0o600}
    entry_bytes = json.dumps({"v": 2, "dest": str(destination), "prior": prior, "before": prior, "after": {"kind": "link", "target": "installed"}}).encode()
    marker_bytes = b'{"previous_generation":null,"target_generation":1,"op":"apply"}'
    entry, marker = home / "journal/intent.json", home / "journal/run.json"
    trace = root / "boundaries.tsv"
    def seed():
        destination.unlink(missing_ok=True)
        destination.symlink_to("installed")
        entry.write_bytes(entry_bytes)
        entry.chmod(0o600)
        marker.write_bytes(marker_bytes)
        marker.chmod(0o644)
        trace.unlink(missing_ok=True)
    seed()
    assert run({"GRIPSACK_FS_TRACE": str(trace)}).returncode == 0
    rows = [line.split("\t", 3) for line in trace.read_text().splitlines()]
    file_index = next(i for i, row in enumerate(rows) if row[1:] == ["Before", "FileSync", json.dumps(blob.name)])
    parent_index = next(i for i in range(file_index + 1, len(rows)) if rows[i][1:] == ["Before", "DirSync", '"."'])
    cases = []
    for boundary, index in [("file", file_index), ("parent", parent_index)]:
        for fault in ["error", "kill"]:
            seed()
            failed = run({"GRIPSACK_FS_CUT": rows[index][0], "GRIPSACK_FS_FAULT": fault})
            assert failed.returncode != 0
            if fault == "kill": assert failed.returncode == -signal.SIGKILL
            assert destination.readlink() == Path("installed")
            assert entry.read_bytes() == entry_bytes and marker.read_bytes() == marker_bytes
            assert blob.read_bytes() == original and not (home / "current").exists()
            assert run().returncode == 0
            assert destination.read_bytes() == original and not entry.exists() and not marker.exists()
            cases.append({"boundary": boundary, "fault": fault, "prior_and_journal_preserved": True, "destination_unchanged_on_failure": True, "retry_restored": True})
    print("RETAINED_PRIOR_SMOKE=" + json.dumps({"cases": cases, "power_loss_claim": False, "fuzz": "not_run"}, sort_keys=True))

