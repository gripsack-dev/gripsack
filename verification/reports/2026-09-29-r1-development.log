=== Initial capture API smoke source (now covered by permanent cases) ===
use gripsack_store::source_bundle::{SourceBundle, SourceInventory};
use std::{io, os::unix::fs::{symlink, PermissionsExt}, path::Path};

fn mode(path: &Path) -> u32 { std::fs::metadata(path).unwrap().permissions().mode() & 0o7777 }

fn main() -> io::Result<()> {
    let temporary = tempfile::tempdir()?;
    let base = temporary.path();
    let repo = base.join("repo");
    let frontend = base.join("frontend");
    let pin = base.join("sdk");
    let home = repo.join("private-state");
    for path in [&repo, &frontend, &pin, &home] { std::fs::create_dir(path)?; }
    std::fs::write(frontend.join("driver.ts"), b"// trusted driver fixture\n")?;
    std::fs::write(pin.join("package.json"), br#"{"name":"@gripsack/core"}"#)?;
    std::fs::write(pin.join("index.ts"), b"export const pinned = 1;\n")?;
    std::fs::write(repo.join(".gitignore"), b"ignored.ts\n")?;
    std::fs::write(repo.join("ignored.ts"), b"export const captured = 1;\n")?;
    std::fs::set_permissions(repo.join("ignored.ts"), std::fs::Permissions::from_mode(0o755))?;
    std::fs::write(home.join("private"), b"not an evaluator source\n")?;
    std::fs::create_dir(repo.join(".git"))?;
    std::fs::write(repo.join(".git/config"), b"control metadata\n")?;
    symlink("ignored.ts", repo.join("alias.ts"))?;
    symlink(repo.join("ignored.ts"), repo.join("absolute.ts"))?;
    std::fs::create_dir_all(repo.join("vendor_modules/@gripsack"))?;
    symlink(&pin, repo.join("vendor_modules/@gripsack/core"))?;
    symlink("vendor_modules", repo.join("node_modules"))?;
    let captured = SourceBundle::capture(&repo, &frontend, Some(&pin), &home)?;
    assert_eq!(std::fs::read(captured.repository().join("ignored.ts"))?, b"export const captured = 1;\n");
    assert_eq!(std::fs::canonicalize(captured.repository().join("alias.ts"))?,
               std::fs::canonicalize(captured.repository().join("ignored.ts"))?);
    assert_eq!(std::fs::canonicalize(captured.repository().join("absolute.ts"))?,
               std::fs::canonicalize(captured.repository().join("ignored.ts"))?);
    assert_eq!(std::fs::canonicalize(captured.repository().join("node_modules/@gripsack/core"))?,
               captured.pinned_frontend().unwrap());
    assert!(!captured.repository().join(".git").exists());
    assert!(!captured.repository().join("private-state").exists());
    assert_eq!(mode(captured.repository()), 0o500);
    assert_eq!(mode(&captured.repository().join("ignored.ts")), 0o500);
    assert_eq!(captured.original_mode(Path::new("alias.ts"))?.bits(), 0o755);
    let admitted = SourceInventory::decode(captured.inventory_bytes(), captured.digest())?;
    assert_eq!(admitted.entries(), captured.inventory().entries());
    std::fs::write(repo.join("ignored.ts"), b"export const captured = 2;\n")?;
    std::fs::write(pin.join("index.ts"), b"export const pinned = 2;\n")?;
    assert_eq!(std::fs::read(captured.repository().join("ignored.ts"))?, b"export const captured = 1;\n");
    assert_eq!(std::fs::read(captured.pinned_frontend().unwrap().join("index.ts"))?, b"export const pinned = 1;\n");
    let changed = SourceBundle::capture(&repo, &frontend, Some(&pin), &home)?;
    assert_ne!(captured.digest(), changed.digest());
    let owned = captured.repository().parent().unwrap().parent().unwrap().to_path_buf();
    drop(captured);
    assert!(!owned.exists());
    let outside = base.join("outside");
    std::fs::write(&outside, b"outside fixture\n")?;
    let outside_mode = mode(&outside);
    symlink(&outside, repo.join("escape"))?;
    assert!(SourceBundle::capture(&repo, &frontend, Some(&pin), &home).is_err());
    assert_eq!(std::fs::read(&outside)?, b"outside fixture\n");
    assert_eq!(mode(&outside), outside_mode);
    std::fs::remove_file(repo.join("escape"))?;
    symlink(".", repo.join("cycle"))?;
    assert!(SourceBundle::capture(&repo, &frontend, Some(&pin), &home).is_err());
    assert_eq!(mode(&repo.join("ignored.ts")), 0o755);
    println!("SOURCE_CAPTURE_SMOKE=ignored_files_alias_identity_external_pin_readonly_original_modes_changed_source_escape_cycle_cleanup PASSED");
    Ok(())
}

