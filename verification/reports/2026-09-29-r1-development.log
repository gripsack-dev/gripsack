import json, os, pathlib, subprocess, tempfile
root = pathlib.Path(tempfile.mkdtemp(prefix='grip-source-alias-'))
repo = root / 'repo'; home = root / 'home'
(repo / 'hosts').mkdir(parents=True); (repo / 'modules').mkdir(); home.mkdir()
(repo / 'env.toml').write_text('[env]\nname="alias witness"\n')
(repo / 'hosts/testhost.ts').write_text('import {defineEnv} from "@gripsack/core"; import value from "../modules/value.ts"; export default defineEnv(() => ({modules:[value]}));\n')
(repo / 'modules/value.ts').write_text('import {module,symlink} from "@gripsack/core"; export default module("value",{config:{alias:symlink("~/.captured-alias")}});\n')
(repo / 'value').write_text('captured source\n')
(repo / 'alias').symlink_to(repo / 'value')
env = dict(os.environ, HOME=str(home), GRIPSACK_HOME=str(home / '.grip'))
env.pop('GRIPSACK_TRUST_ALL', None)
def run(*args):
    return subprocess.run([os.environ['GRIPSACK_BIN'], *args], cwd=repo, env=env, capture_output=True, text=True)
inspected = run('trust','inspect','--json'); assert inspected.returncode == 0, inspected.stderr
source = json.loads(inspected.stdout)
approval = run('trust','add','--bundle',source['bundle_digest'],'--policy',source['policy_digest']); assert approval.returncode == 0, approval.stderr
applied = run('apply','--host','testhost')
print(json.dumps({'returncode':applied.returncode,'stdout':applied.stdout,'stderr':applied.stderr,'installed_exists':(home / '.captured-alias').exists(),'installed_link':(home / '.captured-alias').is_symlink()}))
if applied.returncode == 0:
    assert (home / '.captured-alias').read_text() == 'captured source\n'
    (repo / 'value').write_text('later live source\n')
    assert (home / '.captured-alias').read_text() == 'captured source\n'
    print('materialized alias remains captured after live source mutation')
