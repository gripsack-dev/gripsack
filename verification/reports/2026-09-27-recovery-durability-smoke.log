import hashlib
import json
import os
from pathlib import Path
import subprocess
import tempfile

with tempfile.TemporaryDirectory(prefix="gripsack-recovery-durability-") as temporary:
    sandbox = Path(temporary)
    home = sandbox / "state"
    repo = sandbox / "repo"
    (repo / "hosts").mkdir(parents=True)
    (repo / "env.toml").write_text('[env]\nname="recovery-smoke"\n')
    (repo / "hosts/testhost.ts").write_text('import { defineEnv, module } from "@gripsack/core";\nexport default defineEnv(() => ({ modules: [module("demo", {})] }));\n')
    env = dict(os.environ, HOME=str(sandbox), GRIPSACK_HOME=str(home), GRIPSACK_TRUST_ALL="1", GRIPSACK_FS_RECOVER_ONLY="1", NO_COLOR="1")
    trace = sandbox / "boundaries.tsv"
    def run(extra=None, success=True):
        result = subprocess.run(["grip", "apply", "--host", "testhost"], cwd=repo, env={**env, **(extra or {})}, capture_output=True, text=True, timeout=30)
        print("$ grip apply --host testhost [recovery only]")
        print(result.stdout + result.stderr)
        assert (result.returncode == 0) == success, result.returncode
        return result
    run()
    journal = home / "journal"
    journal.mkdir(exist_ok=True, mode=0o700)
    journal.chmod(0o700)
    marker = journal / "run.json"
    entry = journal / "intent.json"
    dest = sandbox / "interrupted"
    run_bytes = b'{"previous_generation":null,"target_generation":1,"op":"apply"}'
    def record(prior):
        marker.write_bytes(run_bytes)
        marker.chmod(0o644)
        entry.write_text(json.dumps({"v":2,"dest":str(dest),"prior":prior,"before":prior,"after":{"kind":"link","target":"installed"}}))
        entry.chmod(0o600)
        trace.unlink(missing_ok=True)
    def restore_barrier():
        rows = [line.split("\t", 3) for line in trace.read_text().splitlines()]
        start = next(i for i,row in enumerate(rows) if row[1:] == ["After","FileSync",'"run.json"'])
        cleanup = next(i for i,row in enumerate(rows) if row[1:] == ["Before","Unlink",'"intent.json"'])
        return int(next(row[0] for row in rows[start+1:cleanup] if row[1:3] == ["Before","DirSync"]))
    dest.symlink_to("installed")
    record({"kind":"absent"})
    run({"GRIPSACK_FS_TRACE":str(trace)})
    absent_barrier = restore_barrier()
    assert not dest.is_symlink() and not dest.exists() and not marker.exists() and not entry.exists()
    print("ABSENT_RESTORE_DURABLE_BEFORE_CLEANUP=true barrier="+str(absent_barrier))
    origin = b"original private bytes\n"
    blob = home / "prior" / hashlib.sha256(origin).hexdigest()
    blob.parent.mkdir(mode=0o700)
    blob.write_bytes(origin)
    blob.chmod(0o600)
    dest.write_bytes(origin)
    dest.chmod(0o600)
    prior = {"kind":"file","hash":blob.name,"mode":0o600}
    record(prior)
    run({"GRIPSACK_FS_TRACE":str(trace)})
    retry_cut = restore_barrier()
    record(prior)
    expected_entry = entry.read_bytes()
    run({"GRIPSACK_FS_TRACE":str(trace),"GRIPSACK_FS_CUT":str(retry_cut),"GRIPSACK_FS_FAULT":"error"}, success=False)
    assert entry.read_bytes() == expected_entry and marker.read_bytes() == run_bytes
    assert dest.read_bytes() == origin and blob.read_bytes() == origin
    print("OBSERVED_PRIOR_SYNC_FAILURE_RETAINS_EVIDENCE=true")
    run()
    assert not entry.exists() and not marker.exists()
    assert dest.read_bytes() == origin and dest.stat().st_mode & 0o7777 == 0o600
    generation = home / "generations/1"
    generation.mkdir(parents=True)
    manifest = generation / "manifest.json"
    valid_manifest = b'{"number":1,"modules":{}}'
    manifest.write_bytes(valid_manifest)
    (home / "current").symlink_to("generations/1")
    dest.unlink()
    dest.symlink_to("installed")
    record(prior)
    run({"GRIPSACK_FS_TRACE":str(trace)})
    commit_cut = restore_barrier()
    record(prior)
    expected_entry = entry.read_bytes()
    run({"GRIPSACK_FS_TRACE":str(trace),"GRIPSACK_FS_CUT":str(commit_cut),"GRIPSACK_FS_FAULT":"error"}, success=False)
    assert entry.read_bytes() == expected_entry and marker.read_bytes() == run_bytes
    assert dest.readlink() == Path("installed")
    run()
    assert not marker.exists() and not entry.exists()
    print("OBSERVED_CURRENT_SYNC_FAILURE_RETAINS_EVIDENCE=true")
    record(prior)
    expected_entry = entry.read_bytes()
    manifest.write_bytes(b"{torn")
    run(success=False)
    assert entry.read_bytes() == expected_entry and marker.read_bytes() == run_bytes
    assert dest.readlink() == Path("installed")
    manifest.write_bytes(valid_manifest)
    run()
    assert not marker.exists() and not entry.exists()
    print("CORRUPT_CURRENT_REFUSED_BEFORE_CLEANUP=true")
    print('RECOVERY_SMOKE_RESULT={"journeys":4,"passed":4,"failed":0,"power_loss_claim":false,"fuzz":"not_run"}')

SMOKE_SOURCE_END
