from pathlib import Path
import hashlib
import json
import os
import shutil
import subprocess
import sys
import tempfile

root = Path('/repo')
with tempfile.TemporaryDirectory(prefix='gripsack-process-smoke-') as temporary:
    tree = Path(temporary)
    for name in ('Cargo.toml', 'Cargo.lock'):
        shutil.copy2(root / name, tree / name)
    for name in ('crates', 'fuzz', 'typescript', 'schema'):
        shutil.copytree(root / name, tree / name, ignore=shutil.ignore_patterns(
            'target', 'node_modules', '.venv', '__pycache__',
        ))
    source = tree / 'crates/gripsack-process/examples/process_budget_smoke.rs'
    source.parent.mkdir(exist_ok=True)
    shutil.copy2('/process_budget_smoke.rs', source)
    inputs = sorted((tree / 'crates/gripsack-process').rglob('*.rs'))
    inputs += sorted((tree / 'crates/gripsack-policy').rglob('*.rs'))
    print('PROCESS_SMOKE_SOURCE_SHA256=' + json.dumps({str(path.relative_to(tree)): hashlib.sha256(
        path.read_bytes()).hexdigest() for path in inputs}, sort_keys=True), flush=True)
    command = ['cargo', 'run', '--locked', '-p', 'gripsack-process', '--example',
               'process_budget_smoke', '--', *sys.argv[1:]]
    print('RUNNER_COMMAND=' + ' '.join(command), flush=True)
    result = subprocess.run(command, cwd=tree,
                            env={**os.environ, 'CARGO_TARGET_DIR': '/app/target'},
                            timeout=600)
    binary = Path('/app/target/debug/examples/process_budget_smoke')
    if binary.exists():
        print('PROCESS_SMOKE_BINARY_SHA256=' + hashlib.sha256(binary.read_bytes()).hexdigest(), flush=True)
    raise SystemExit(result.returncode)


=== EARLIER STANDALONE PUBLIC-API SMOKE SOURCE ===

use gripsack_process::{Control, FrameByteLimit, Limits, RetainedStderrLimit, StopReason, StdoutByteLimit};
use std::os::unix::process::CommandExt;
use std::process::Command;
use std::time::Duration;

fn command(body: &str) -> Command {
    let mut command = Command::new("/bin/sh");
    command.args(["-c", body]).env_clear().current_dir("/tmp");
    command
}

fn permission_denial() {
    let status = std::fs::read_to_string("/proc/self/status").unwrap();
    let capabilities = status.lines().find_map(|line| line.strip_prefix("CapEff:\t")).unwrap();
    let effective = u64::from_str_radix(capabilities, 16).unwrap();
    assert_eq!(effective & (1 << 5), 0, "smoke requires CAP_KILL to be dropped");
    assert!(status.lines().any(|line| line.starts_with("Uid:\t0\t0\t0\t0")), "smoke requires container root");
    let mut child = command("exit 0");
    child.uid(65534).gid(65534);
    let outcome = gripsack_process::run(&mut child, b"", Limits {
        timeout: Duration::from_secs(2), ..Limits::default()
    }, |_| Control::Continue).unwrap();
    println!("DENIED_GROUP_SIGNAL_OUTCOME={outcome:?}");
    assert!(matches!(&outcome.reason, StopReason::Cleanup { error, .. }
        if error.kind() == std::io::ErrorKind::PermissionDenied),
        "denied_group_signal_was_reported_successfully: {outcome:?}");
    assert_eq!(outcome.status.unwrap().code(), Some(0));
    println!("PERMISSION_DENIAL_SMOKE=passed");
}

fn main() {
    if std::env::args().any(|arg| arg == "--permission-denial") {
        permission_denial();
        return;
    }
    let input: Vec<u8> = (0..36003).map(|i| (i % 251) as u8).collect();
    let mut output = Vec::new();
    let outcome = gripsack_process::run_raw(&mut command("cat"), &input, Limits {
        line_bytes: FrameByteLimit::new(1),
        stdout_bytes: StdoutByteLimit::new(input.len() as u64),
        ..Limits::default()
    }, |bytes| { output.extend_from_slice(bytes); Control::Continue }).unwrap();
    assert!(matches!(outcome.reason, StopReason::Exited), "{outcome:?}");
    assert!(outcome.status.unwrap().success());
    assert_eq!(output, input);
    println!("RAW_EXACT_INPUT_AND_STDOUT_BOUNDARY=passed bytes={}", output.len());

    let mut lines = Vec::new();
    let outcome = gripsack_process::run(&mut command("printf 'first\n'; cat >/dev/null; printf 'ignored\n'; exit 9"), &input,
        Limits::default(), |line| { lines.push(line.to_vec()); Control::Response }).unwrap();
    assert!(matches!(outcome.reason, StopReason::Exited), "{outcome:?}");
    assert_eq!(outcome.status.unwrap().code(), Some(9));
    assert_eq!(lines, [b"first".to_vec()]);
    println!("RESPONSE_PRESERVES_INPUT_AND_EXIT_FAILURE=passed");

    let outcome = gripsack_process::run_raw(&mut command("cat >&2"), &input, Limits {
        retained_stderr_bytes: RetainedStderrLimit::new(13), ..Limits::default()
    }, |_| panic!("unexpected stdout")).unwrap();
    assert!(matches!(outcome.reason, StopReason::Exited), "{outcome:?}");
    assert!(outcome.status.unwrap().success());
    assert_eq!(outcome.stderr, input[input.len() - 13..]);
    assert!(outcome.stderr_truncated);
    println!("BINARY_STDERR_SUFFIX=passed retained=13");

    let outcome = gripsack_process::run(&mut command("printf 12345"), b"", Limits {
        line_bytes: FrameByteLimit::new(4), ..Limits::default()
    }, |_| panic!("oversize fragment delivered")).unwrap();
    assert!(matches!(outcome.reason, StopReason::LineLimit), "{outcome:?}");
    assert!(outcome.status.is_some());
    println!("OVERSIZE_EOF_FRAGMENT_REFUSED=passed");
    println!("PROCESS_BUDGET_SMOKES=4");
}


