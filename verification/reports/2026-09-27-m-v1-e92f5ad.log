@!!BEGIN
@!!type:obligation
@!!id:7
@!!loc:66:3:66:5
@!!status:being proved
@!!prover:isabelle
@!!meth:auto; time-limit: 60
@!!obl:
ASSUME NEW CONSTANT PREV,
       NEW CONSTANT TARGET,
       NEW CONSTANT OP,
       NEW CONSTANT KIND,
       NEW CONSTANT CPRIOR,
       NEW CONSTANT CDEPLOYED,
       NEW CONSTANT CEDITED,
       NEW CONSTANT NONE,
       NEW VARIABLE volatile,
       NEW VARIABLE durable,
       NEW VARIABLE visible,
       NEW VARIABLE phase,
       NEW VARIABLE step,
       NEW VARIABLE edited,
       NEW VARIABLE klass,
       NEW VARIABLE beforeRecover,
       TRUE 
PROVE  \A live, prior, intended :
          (/\ NONE # [prior |-> prior, intended |-> intended]
           /\ NONE # [prev |-> PREV, target |-> TARGET]
           /\ PREV # TARGET)
          => (CASE (IF
                      [dest |-> live, current |-> PREV,
                       entry |-> [prior |-> prior, intended |-> intended],
                       marker |-> [prev |-> PREV, target |-> TARGET]].marker
                      = NONE
                      /\ [dest |-> live, current |-> PREV,
                          entry |-> [prior |-> prior, intended |-> intended],
                          marker |-> [prev |-> PREV, target |-> TARGET]].entry
                         = NONE
                      THEN "none"
                      ELSE IF
                             [dest |-> live, current |-> PREV,
                              entry |-> [prior |-> prior,
                                         intended |-> intended],
                              marker |-> [prev |-> PREV, target |-> TARGET]].marker
                             = NONE
                             THEN "uncommitted"
                             ELSE CASE [dest |-> live, current |-> PREV,
                                        entry |-> [prior |-> prior,
                                                   intended |-> intended],
                                        marker |-> [prev |-> PREV,
                                                    target |-> TARGET]].current
                                       = [dest |-> live, current |-> PREV,
                                          entry |-> [prior |-> prior,
                                                     intended |-> intended],
                                          marker |-> [prev |-> PREV,
                                                      target |-> TARGET]].marker.target ->
                                         "committed"
                                    [] [dest |-> live, current |-> PREV,
                                        entry |-> [prior |-> prior,
                                                   intended |-> intended],
                                        marker |-> [prev |-> PREV,
                                                    target |-> TARGET]].current
                                       = [dest |-> live, current |-> PREV,
                                          entry |-> [prior |-> prior,
                                                     intended |-> intended],
                                          marker |-> [prev |-> PREV,
                                                      target |-> TARGET]].marker.prev ->
                                         "uncommitted"
                                    [] OTHER -> "ambiguous")
                   = "committed" ->
                     [dest |-> [dest |-> live, current |-> PREV,
                                entry |-> [prior |-> prior,
                                           intended |-> intended],
                                marker |-> [prev |-> PREV, target |-> TARGET]].dest,
                      current |-> [dest |-> live, current |-> PREV,
                                   entry |-> [prior |-> prior,
                                              intended |-> intended],
                                   marker |-> [prev |-> PREV,
                                               target |-> TARGET]].current,
                      entry |-> NONE, marker |-> NONE]
                [] (IF
                      [dest |-> live, current |-> PREV,
                       entry |-> [prior |-> prior, intended |-> intended],
                       marker |-> [prev |-> PREV, target |-> TARGET]].marker
                      = NONE
                      /\ [dest |-> live, current |-> PREV,
                          entry |-> [prior |-> prior, intended |-> intended],
                          marker |-> [prev |-> PREV, target |-> TARGET]].entry
                         = NONE
                      THEN "none"
                      ELSE IF
                             [dest |-> live, current |-> PREV,
                              entry |-> [prior |-> prior,
                                         intended |-> intended],
                              marker |-> [prev |-> PREV, target |-> TARGET]].marker
                             = NONE
                             THEN "uncommitted"
                             ELSE CASE [dest |-> live, current |-> PREV,
                                        entry |-> [prior |-> prior,
                                                   intended |-> intended],
                                        marker |-> [prev |-> PREV,
                                                    target |-> TARGET]].current
                                       = [dest |-> live, current |-> PREV,
                                          entry |-> [prior |-> prior,
                                                     intended |-> intended],
                                          marker |-> [prev |-> PREV,
                                                      target |-> TARGET]].marker.target ->
                                         "committed"
                                    [] [dest |-> live, current |-> PREV,
                                        entry |-> [prior |-> prior,
                                                   intended |-> intended],
                                        marker |-> [prev |-> PREV,
                                                    target |-> TARGET]].current
                                       = [dest |-> live, current |-> PREV,
                                          entry |-> [prior |-> prior,
                                                     intended |-> intended],
                                          marker |-> [prev |-> PREV,
                                                      target |-> TARGET]].marker.prev ->
                                         "uncommitted"
                                    [] OTHER -> "ambiguous")
                   = "uncommitted" ->
                     [dest |-> IF
                                 [dest |-> live, current |-> PREV,
                                  entry |-> [prior |-> prior,
                                             intended |-> intended],
                                  marker |-> [prev |-> PREV,
                                              target |-> TARGET]].entry
                                 = NONE
                                 THEN [dest |-> live, current |-> PREV,
                                       entry |-> [prior |-> prior,
                                                  intended |-> intended],
                                       marker |-> [prev |-> PREV,
                                                   target |-> TARGET]].dest
                                 ELSE IF
                                        Decide([dest |-> live,
                                                current |-> PREV,
                                                entry |-> [prior |-> prior,
                                                           intended |-> intended],
                                                marker |-> [prev |-> PREV,
                                                            target |-> TARGET]].dest,
                                               [dest |-> live,
                                                current |-> PREV,
                                                entry |-> [prior |-> prior,
                                                           intended |-> intended],
                                                marker |-> [prev |-> PREV,
                                                            target |-> TARGET]].entry.intended,
                                               [dest |-> live,
                                                current |-> PREV,
                                                entry |-> [prior |-> prior,
                                                           intended |-> intended],
                                                marker |-> [prev |-> PREV,
                                                            target |-> TARGET]].entry.prior)
                                        = "restore"
                                        THEN [dest |-> live,
                                              current |-> PREV,
                                              entry |-> [prior |-> prior,
                                                         intended |-> intended],
                                              marker |-> [prev |-> PREV,
                                                          target |-> TARGET]].entry.prior
                                        ELSE [dest |-> live,
                                              current |-> PREV,
                                              entry |-> [prior |-> prior,
                                                         intended |-> intended],
                                              marker |-> [prev |-> PREV,
                                                          target |-> TARGET]].dest,
                      current |-> [dest |-> live, current |-> PREV,
                                   entry |-> [prior |-> prior,
                                              intended |-> intended],
                                   marker |-> [prev |-> PREV,
                                               target |-> TARGET]].current,
                      entry |-> NONE, marker |-> NONE]
                [] OTHER ->
                     [dest |-> live, current |-> PREV,
                      entry |-> [prior |-> prior, intended |-> intended],
                      marker |-> [prev |-> PREV, target |-> TARGET]])
             = [dest |-> IF Decide(live, intended, prior) = "restore"
                           THEN prior
                           ELSE live,
                current |-> PREV, entry |-> NONE, marker |-> NONE]

@!!END

