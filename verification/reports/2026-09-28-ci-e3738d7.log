eady = self.ready@;"}, {"highlight_end": 47, "highlight_start": 1, "text": "        let ghost pre_head = self.head as int;"}, {"highlight_end": 44, "highlight_start": 1, "text": "        let module = self.ready[self.head];"}, {"highlight_end": 16, "highlight_start": 1, "text": "        proof {"}, {"highlight_end": 70, "highlight_start": 1, "text": "            // queue-readiness: the popped module is fully unblocked,"}, {"highlight_end": 67, "highlight_start": 1, "text": "            // so every dependency finished (the exact-count link)"}, {"highlight_end": 51, "highlight_start": 1, "text": "            assert(!self.started@[module as int]);"}, {"highlight_end": 57, "highlight_start": 1, "text": "            assert(self.remaining@[module as int] == 0);"}, {"highlight_end": 85, "highlight_start": 1, "text": "            lemma_unfinished_count_zero(self.deps@[module as int]@, self.finished@);"}, {"highlight_end": 10, "highlight_start": 1, "text": "        }"}, {"highlight_end": 24, "highlight_start": 1, "text": "        self.head += 1;"}, {"highlight_end": 37, "highlight_start": 1, "text": "        self.started[module] = true;"}, {"highlight_end": 16, "highlight_start": 1, "text": "        proof {"}, {"highlight_end": 71, "highlight_start": 1, "text": "            // the entry readiness clause, restated over the snapshots"}, {"highlight_end": 79, "highlight_start": 1, "text": "            assert(forall|i: int| #![trigger pre_started[i], pre_remaining[i]]"}, {"highlight_end": 61, "highlight_start": 1, "text": "                0 <= i < self.deps@.len() && !pre_started[i]"}, {"highlight_end": 61, "highlight_start": 1, "text": "                    && pre_remaining[i] == 0 && !self.failed"}, {"highlight_end": 54, "highlight_start": 1, "text": "                ==> pre_queued.contains(i as usize));"}, {"highlight_end": 44, "highlight_start": 1, "text": "            // the popped module was queued"}, {"highlight_end": 53, "highlight_start": 1, "text": "            assert(pre_queued.contains(module)) by {"}, {"highlight_end": 99, "highlight_start": 1, "text": "                assert(pre_ready.subrange(pre_head, pre_ready.len() as int).contains(module)) by {"}, {"highlight_end": 59, "highlight_start": 1, "text": "                    assert(pre_ready[pre_head] == module);"}, {"highlight_end": 19, "highlight_start": 1, "text": "                };"}, {"highlight_end": 15, "highlight_start": 1, "text": "            };"}, {"highlight_end": 60, "highlight_start": 1, "text": "            self.queued = Ghost(pre_queued.remove(module));"}, {"highlight_end": 62, "highlight_start": 1, "text": "            // the entry window was [module] plus the new one"}, {"highlight_end": 72, "highlight_start": 1, "text": "            assert(pre_ready.subrange(pre_head, pre_ready.len() as int)"}, {"highlight_end": 101, "highlight_start": 1, "text": "                == seq![module] + self.ready@.subrange(self.head as int, self.ready@.len() as int));"}, {"highlight_end": 34, "highlight_start": 1, "text": "            assert forall|i: int|"}, {"highlight_end": 60, "highlight_start": 1, "text": "                #![trigger pre_queued.contains(i as usize)]"}, {"highlight_end": 46, "highlight_start": 1, "text": "                0 <= i < self.deps@.len() ==>"}, {"highlight_end": 51, "highlight_start": 1, "text": "                (self.queued@.contains(i as usize)"}, {"highlight_end": 84, "highlight_start": 1, "text": "                    <==> (pre_queued.contains(i as usize) && i as usize != module))"}, {"highlight_end": 17, "highlight_start": 1, "text": "            by {"}, {"highlight_end": 15, "highlight_start": 1, "text": "            };"}, {"highlight_end": 93, "highlight_start": 1, "text": "            assert(self.ready@.subrange(self.head as int, self.ready@.len() as int).to_set()"}, {"highlight_end": 35, "highlight_start": 1, "text": "                =~= self.queued@);"}, {"highlight_end": 61, "highlight_start": 1, "text": "            assert forall|k: int| #![trigger self.ready@[k]]"}, {"highlight_end": 59, "highlight_start": 1, "text": "                self.head <= k < self.ready@.len() implies"}, {"highlight_end": 54, "highlight_start": 1, "text": "                !self.started@[self.ready@[k] as int]"}, {"highlight_end": 63, "highlight_start": 1, "text": "                && self.remaining@[self.ready@[k] as int] == 0"}, {"highlight_end": 17, "highlight_start": 1, "text": "            by {"}, {"highlight_end": 61, "highlight_start": 1, "text": "                assert(pre_queued.contains(self.ready@[k]));"}, {"highlight_end": 50, "highlight_start": 1, "text": "                assert(self.ready@[k] != module);"}, {"highlight_end": 15, "highlight_start": 1, "text": "            };"}, {"highlight_end": 83, "highlight_start": 1, "text": "            assert forall|i: int| #![trigger self.started@[i], self.remaining@[i]]"}, {"highlight_end": 63, "highlight_start": 1, "text": "                0 <= i < self.deps@.len() && !self.started@[i]"}, {"highlight_end": 63, "highlight_start": 1, "text": "                    && self.remaining@[i] == 0 && !self.failed"}, {"highlight_end": 58, "highlight_start": 1, "text": "                implies self.queued@.contains(i as usize)"}, {"highlight_end": 17, "highlight_start": 1, "text": "            by {"}, {"highlight_end": 41, "highlight_start": 1, "text": "                assert(!pre_started[i]);"}, {"highlight_end": 47, "highlight_start": 1, "text": "                assert(pre_remaining[i] == 0);"}, {"highlight_end": 57, "highlight_start": 1, "text": "                assert(pre_queued.contains(i as usize));"}, {"highlight_end": 67, "highlight_start": 1, "text": "                assert(self.deps@.len() <= usize::MAX as int) by {"}, {"highlight_end": 103, "highlight_start": 1, "text": "                    assert(self.deps@.len() == vstd::std_specs::vec::spec_vec_len(&self.deps) as int);"}, {"highlight_end": 19, "highlight_start": 1, "text": "                };"}, {"highlight_end": 48, "highl