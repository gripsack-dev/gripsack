import json, os, pathlib, shutil, subprocess, tempfile
base = pathlib.Path(tempfile.mkdtemp(prefix='npm-boundary-'))
real = os.environ['GRIPSACK_DENO']
for strategy in ('no-npm', 'deny-read', 'ignore-read', 'isolated', 'explicit-config'):
    for local in (False, True):
        root = base / f'{strategy}-{local}'; root.mkdir()
        home = root / 'home'; home.mkdir()
        repo = root / 'repo'; (repo / 'hosts').mkdir(parents=True); (repo / 'modules').mkdir()
        package = (repo if local else root) / 'node_modules/ambient-fixture'
        package.mkdir(parents=True)
        (package / 'package.json').write_text('{"name":"ambient-fixture","version":"1.0.0","type":"module","main":"index.js"}')
        (package / 'index.js').write_text('export default "loaded-package";\n')
        (repo / 'package.json').write_text('{"type":"module","dependencies":{"ambient-fixture":"1.0.0"}}')
        (repo / 'env.toml').write_text('[env]\nname="fixture"\n')
        (repo / 'hosts/testhost.ts').write_text('import {defineEnv} from "@gripsack/core"; import selected from "../modules/selected.ts"; export default defineEnv(() => ({modules:[selected]}));')
        (repo / 'modules/selected.ts').write_text('import {module} from "@gripsack/core"; import value from "ambient-fixture"; export default module(value,{install:[]});')
        flag = {'no-npm':'--no-npm', 'deny-read':f'--deny-read={root / "node_modules"}', 'ignore-read':f'--ignore-read={root / "node_modules"}', 'isolated':'--node-modules-linker=isolated'}.get(strategy)
        wrapper = root / 'deno-wrapper'
        if strategy == 'explicit-config':
            configure = '\nconfig = pathlib.Path.cwd().parent / "config.json"\nconfig.write_text(json.dumps({"nodeModulesDir":"manual"}))\nargs = [arg for arg in args if arg != "--no-config"]\nargs.insert(1, "--config=" + str(config))\n'
        else:
            configure = f'\nargs.insert(1, {flag!r})\n'
        wrapper.write_text('#!/usr/bin/env python3\nimport json,os,pathlib,sys\n' + f'real={real!r}\nargs=sys.argv[1:]\n' + 'if args == ["--version"]: os.execv(real,[real,*args])\n' + configure + 'os.execv(real,[real,*args])\n')
        wrapper.chmod(0o700)
        env = dict(os.environ, HOME=str(home), GRIPSACK_HOME=str(home / '.grip'), TMPDIR=str(root), GRIPSACK_DENO=str(wrapper))
        env.pop('GRIPSACK_TRUST_ALL',None)
        def run(*args): return subprocess.run([os.environ['GRIPSACK_BIN'],*args],cwd=repo,env=env,capture_output=True,text=True,timeout=30)
        inspected=run('trust','inspect','--json'); assert inspected.returncode==0,inspected.stderr
        s=json.loads(inspected.stdout)
        approval=run('trust','add','--bundle',s['bundle_digest'],'--policy',s['policy_digest']); assert approval.returncode==0,approval.stderr
        result=run('check','--host','testhost','--json')
        print(json.dumps({'strategy':strategy,'local':local,'returncode':result.returncode,'stdout':result.stdout,'stderr':result.stderr[-2000:]}),flush=True)
