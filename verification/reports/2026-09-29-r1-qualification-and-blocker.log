import json, os, pathlib, subprocess, tempfile
root = pathlib.Path(tempfile.mkdtemp(prefix='deno-package-profile-'))
deno = os.environ['GRIPSACK_DENO']
for outside_npm in (False, True):
    for kind in ('esm-dir-map', 'cjs-ambient', 'esm-ambient', 'esm-transitive'):
        base = root / f'{outside_npm}-{kind}'; base.mkdir()
        admitted = base / 'admitted'; (admitted / 'hosts').mkdir(parents=True)
        directory = admitted / ('dependencies/package' if outside_npm else 'node_modules/package')
        directory.mkdir(parents=True)
        outside = base / 'outside'; outside.mkdir()
        (outside / 'secret.json').write_text('{"value":"unapproved"}')
        (outside / 'secret.js').write_text('export default "unapproved";')
        (admitted / 'package.json').write_text('{"type":"module","dependencies":{"package":"1.0.0"}}')
        cjs = kind.startswith('cjs')
        entry = directory / ('index.cjs' if cjs else 'index.js')
        (directory / 'package.json').write_text(json.dumps({'name':'package','version':'1.0.0','type':'commonjs' if cjs else 'module','main':entry.name,'dependencies':{'child':'1.0.0','ambient':'1.0.0'}}))
        if kind.endswith('ambient'):
            ambient = base / 'node_modules/ambient'; ambient.mkdir(parents=True)
            (ambient / 'package.json').write_text(json.dumps({'name':'ambient','version':'1.0.0','type':'commonjs' if cjs else 'module','main':'index.js'}))
            (ambient / 'index.js').write_text('module.exports="ambient";' if cjs else 'export default "ambient";')
            body = 'module.exports = require("ambient");' if cjs else 'import value from "ambient"; export default value;'
        elif kind == 'esm-transitive':
            child = directory / 'node_modules/child'; child.mkdir(parents=True)
            (child / 'package.json').write_text('{"name":"child","version":"1.0.0","type":"module","main":"index.js"}')
            (child / 'index.js').write_text('export default "local-transitive";')
            body = 'import value from "child"; export default value;'
        else: body = 'export default "local";'
        entry.write_text(body)
        (admitted / 'hosts/host.ts').write_text('import value from "package"; export default value;')
        (admitted / 'driver.ts').write_text('import {pathToFileURL} from "node:url"; const result=await import(pathToFileURL(Deno.args[0]).href); console.log(JSON.stringify(result.default));')
        imports=admitted / 'imports.json'; imports.write_text(json.dumps({'imports':{'package':directory.as_uri() if kind == 'esm-dir-map' else entry.as_uri()}}))
        args=[deno,'run','--no-remote','--cached-only','--no-lock','--no-config','--no-npm','--node-modules-dir=manual',f'--allow-read={admitted}',f'--import-map={imports}',str(admitted / 'driver.ts'),str(admitted / 'hosts/host.ts')]
        result=subprocess.run(args,cwd=admitted,env={'PATH':os.environ['PATH'],'HOME':str(base),'DENO_DIR':str(base / 'cache')},capture_output=True,text=True,timeout=20)
        print(json.dumps({'outside_npm':outside_npm,'kind':kind,'returncode':result.returncode,'stdout':result.stdout,'stderr':result.stderr[:2000]}),flush=True)

