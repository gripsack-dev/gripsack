from pathlib import Path
import hashlib
import json
import shutil
import sys
import tempfile

sys.path.insert(0, '/repo/scripts')
from check_tlaps import prove
from tlaps_catalog import load_catalog

root = Path('/repo')
catalog = load_catalog(root / 'specs/recovery-proofs.json', root / 'specs')
with tempfile.TemporaryDirectory(prefix='coupling-ci-') as temporary:
    work = Path(temporary)
    for source in catalog.sources:
        shutil.copy2(source, work / source.name)
    print('SOURCE_SHA256=' + json.dumps({source.name: hashlib.sha256((work / source.name).read_bytes()).hexdigest() for source in catalog.sources}, sort_keys=True), flush=True)
    unit = next(unit for unit in catalog.units if unit.module == 'ActivationCouplingSteps')
    source = work / 'ActivationCouplingSteps.tla'
    status, evidence = prove(source, work / 'fresh-cache')
    evidence.positive(status, unit.minimum_obligations, source, unit.theorems)
    print(f'COUPLING_OBLIGATIONS={evidence.count}', flush=True)


