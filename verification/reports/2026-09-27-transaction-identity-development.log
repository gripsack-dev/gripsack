STANDALONE SCRIPT
import json
import os
from pathlib import Path
import signal
import subprocess
import tempfile

with tempfile.TemporaryDirectory(prefix="gripsack-same-generation-") as temporary:
    root = Path(temporary)
    repo = root / "repo"
    home = root / "state"
    (repo / "hosts").mkdir(parents=True)
    (repo / "env.toml").write_text('[env]\nname="same-generation"\n')
    (repo / "hosts/testhost.ts").write_text('import { defineEnv, module, symlink } from "@gripsack/core";\nexport default defineEnv(() => ({ modules: [module("demo", {config:{a:symlink("~/.a"),b:symlink("~/.b")}})] }));\n')
    (repo / "a").write_text("a")
    (repo / "b").write_text("b")
    env = dict(os.environ, HOME=str(root), GRIPSACK_HOME=str(home), GRIPSACK_TRUST_ALL="1", NO_COLOR="1")
    def run(args, extra=None):
        result = subprocess.run(["grip", *args], cwd=repo, env={**env, **(extra or {})}, capture_output=True, text=True, timeout=30)
        print("$ grip " + " ".join(args), "exit="+str(result.returncode))
        print(result.stdout + result.stderr)
        return result
    assert run(["apply","--host","testhost"]).returncode == 0
    links = [root / ".a", root / ".b"]
    for path in links:
        path.unlink()
    trace = root / "boundaries.tsv"
    assert run(["rollback","1"], {"GRIPSACK_FS_TRACE":str(trace)}).returncode == 0
    rows = [line.split("\t",3) for line in trace.read_text().splitlines()]
    cut = next(int(row[0]) for row in rows if row[1:] == ["Before","Symlink",'".b"'])
    for path in links:
        path.unlink()
    trace.unlink()
    interrupted = run(["rollback","1"], {"GRIPSACK_FS_CUT":str(cut), "GRIPSACK_FS_FAULT":"kill"})
    assert interrupted.returncode == -signal.SIGKILL
    after_crash = [path.is_symlink() for path in links]
    assert after_crash == [True, False], after_crash
    assert run(["apply","--host","testhost"], {"GRIPSACK_FS_RECOVER_ONLY":"1"}).returncode == 0
    after_recovery = [path.is_symlink() for path in links]
    print("SAME_GENERATION_WITNESS="+json.dumps({"before":[False,False],"after_crash":after_crash,"after_recovery":after_recovery,"journal_empty":not list((home / "journal").glob("*.json")),"partial_state_survives":after_recovery == [True,False]}, sort_keys=True))
