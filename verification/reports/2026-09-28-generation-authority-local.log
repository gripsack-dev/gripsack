=== Standalone rollback driver (sha256 52eeb1d57d90932a05cdbd269238364badec91e117b796475d56ce4d0e00bcc4) ===
import hashlib
import json
import os
from pathlib import Path
import signal
import subprocess
import sys
import tempfile

sys.path.insert(0, "/app/e2e")
from conftest import make_env_repo

binary = Path(os.environ["GRIPSACK_BIN"])
print("binary_sha256=" + hashlib.sha256(binary.read_bytes()).hexdigest(), flush=True)
with tempfile.TemporaryDirectory(prefix="generation-admission-smoke-") as scratch:
    sandbox = Path(scratch)
    home = sandbox / ".local/share/gripsack"
    env = {**os.environ, "HOME": str(sandbox), "GRIPSACK_HOME": str(home),
           "GRIPSACK_TRUST_ALL": "1"}
    env.pop("XDG_DATA_HOME", None)
    repo = make_env_repo(sandbox / "env", '''
import { module, trackedCopy } from "@gripsack/core";
export default module("demo", {config: {source: trackedCopy("~/.observed-generation")}});
''')
    source = repo / "source"
    destination = sandbox / ".observed-generation"

    def invoke(args, extra=None):
        result = subprocess.run([str(binary), *args], cwd=repo,
            env={**env, **(extra or {})}, capture_output=True, text=True, timeout=30)
        return result

    def success(args, extra=None):
        result = invoke(args, extra)
        assert result.returncode == 0, result.stdout + result.stderr
        return result

    source.write_text("generation one\n")
    success(["apply", "--host", "testhost"])
    source.write_text("generation two\n")
    success(["apply", "--host", "testhost"])
    trace = sandbox / "rollback.tsv"
    success(["rollback", "1"], {"GRIPSACK_FS_TRACE": str(trace)})
    assert destination.read_text() == "generation one\n"
    rows = [line.split("\t", 3) for line in trace.read_text().splitlines()]
    cut = next(int(row[0]) for row in rows
               if row[1:] == ["Before", "FileSync", '"manifest.json"'])
    for fault in ["error", "kill"]:
        success(["apply", "--host", "testhost"])
        current = (home / "current").readlink()
        assert destination.read_text() == "generation two\n"
        failed = invoke(["rollback", "1"],
                        {"GRIPSACK_FS_CUT": str(cut), "GRIPSACK_FS_FAULT": fault})
        assert failed.returncode != 0, failed.stdout + failed.stderr
        if fault == "kill":
            assert failed.returncode == -signal.SIGKILL
        assert (home / "current").readlink() == current
        assert destination.read_text() == "generation two\n"
        print(json.dumps({"fault": fault, "exit": failed.returncode,
                          "current_preserved": str(current),
                          "destination": destination.read_text().strip()}), flush=True)
        success(["rollback", "1"])
        assert destination.read_text() == "generation one\n"
        assert (home / "current").resolve().name == "1"
        print("clean_retry=restored-generation-one", flush=True)
    inspection_trace = sandbox / "inspection.tsv"
    success(["generations"], {"GRIPSACK_FS_TRACE": str(inspection_trace)})
    rows = [line.split("\t", 3) for line in inspection_trace.read_text().splitlines()]
    assert not any(row[1:] == ["Before", "FileSync", '"manifest.json"'] for row in rows)
    print("inspection=read-only-manifest-view", flush=True)

=== Standalone legacy-floor driver (sha256 329bfebbcbe05fcf10f694285ff988885fb8c618d0ba6b4d1c72f76c501cb6e6) ===
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
sys.path.insert(0, "/app/e2e")
from conftest import make_env_repo
with tempfile.TemporaryDirectory(prefix="legacy-high-water-") as scratch:
    sandbox = Path(scratch)
    home = sandbox / ".local/share/gripsack"
    env = {**os.environ, "HOME": str(sandbox), "GRIPSACK_HOME": str(home), "GRIPSACK_TRUST_ALL": "1"}
    env.pop("XDG_DATA_HOME", None)
    repo = make_env_repo(sandbox / "env", '''
import { module, symlink } from "@gripsack/core";
export default module("demo", {config: {source: symlink("~/.legacy-high-water")}});
''')
    (repo / "source").write_text("legacy migration\n")
    (repo / "env.toml").write_text('[env]\nname="fixture"\n[settings]\nkeep_generations=0\n')
    for number in (10, 20):
        generation = home / "generations" / str(number)
        generation.mkdir(parents=True)
        (generation / "manifest.json").write_text(json.dumps({"number": number, "modules": {}}))
    (home / "current").symlink_to("generations/10")
    def run(*args):
        result = subprocess.run([os.environ["GRIPSACK_BIN"], *args], cwd=repo, env=env,
                                text=True, capture_output=True, timeout=30)
        print(json.dumps({"command": args, "exit": result.returncode,
                          "stdout": result.stdout, "stderr": result.stderr}), flush=True)
        assert result.returncode == 0
    run("gc")
    assert not (home / "generations/20").exists()
    run("apply", "--host", "testhost")
    selected = (home / "current").resolve().name
    print(json.dumps({"highest_previously_retained": 20, "new_selection": int(selected),
                      "high_water": (home / "generations/high-water").read_text()}), flush=True)
    assert int(selected) > 20, "legacy GC discarded allocation history before recording high-water"

