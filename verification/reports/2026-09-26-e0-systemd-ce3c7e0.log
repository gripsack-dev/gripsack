#!/usr/bin/env python3
"""Qualify one disposable user-calendar timer without changing persistent schedules."""
from __future__ import annotations

import datetime as dt
import json
import os
from pathlib import Path
import secrets
import subprocess
import sys
import time

root = Path(__file__).resolve().parent
unit = "gripsack-e0-qual-" + secrets.token_hex(6)
service = unit + ".service"
timer = unit + ".timer"
marker = root / "fired.utc"
started = dt.datetime.now().astimezone()
trigger = (started + dt.timedelta(seconds=25)).strftime("%Y-%m-%d %H:%M:%S")
report: dict[str, object] = {
    "unit": unit,
    "source_date": started.isoformat(),
    "requested_calendar": trigger,
    "user_id": os.getuid(),
    "service_marker": str(marker),
    "commands": [],
}


def command(*args: str, required: bool = True, timeout: int = 12) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
    report["commands"].append({
        "argv": list(args), "exit": result.returncode,
        "stdout": result.stdout.strip(), "stderr": result.stderr.strip(),
    })
    if required and result.returncode:
        raise RuntimeError(f"{args!r} exited {result.returncode}: {result.stderr}")
    return result


try:
    report["version"] = command("systemd", "--version").stdout.splitlines()[0]
    report["user_manager"] = command("systemctl", "--user", "is-system-running").stdout.strip()
    report["linger"] = command("loginctl", "show-user", str(os.getuid()), "-p", "Linger").stdout.strip()
    report["daily_calendar"] = command("systemd-analyze", "calendar", "daily").stdout.strip()
    if command("systemctl", "--user", "show", timer, "-p", "LoadState", "--value", required=False).stdout.strip() == "loaded":
        raise RuntimeError("random fixture unit already exists; do not replace it")
    service_code = (
        "from datetime import datetime, timezone; from pathlib import Path; import sys; "
        "Path(sys.argv[1]).write_text(datetime.now(timezone.utc).isoformat() + '\\n')"
    )
    command(
        "systemd-run", "--user", "--collect", "--unit", unit,
        "--on-calendar", trigger,
        "--timer-property=AccuracySec=1s", "--timer-property=Persistent=no",
        "--property=Type=oneshot", "--property=Restart=no",
        "/usr/bin/python3", "-c", service_code, str(marker),
    )
    report["timer_unit"] = command(
        "systemctl", "--user", "show", timer,
        "-p", "LoadState", "-p", "Unit", "-p", "AccuracyUSec",
        "-p", "Persistent", "-p", "NextElapseUSecRealtime",
    ).stdout.strip()
    if "LoadState=loaded" not in report["timer_unit"] or f"Unit={service}" not in report["timer_unit"]:
        raise RuntimeError(f"timer did not bind intended service: {report['timer_unit']}")
    deadline = time.monotonic() + 85
    while time.monotonic() < deadline:
        if marker.is_file() and marker.stat().st_size:
            break
        time.sleep(0.2)
    if not marker.is_file() or not marker.stat().st_size:
        raise RuntimeError("user-manager calendar trigger never completed the service output")
    report["fired_utc"] = marker.read_text().strip()
    report["marker_owner_uid"] = marker.stat().st_uid
    if report["marker_owner_uid"] != os.getuid():
        raise RuntimeError("service did not run in the expected user domain")
    report["service_after_run"] = command(
        "systemctl", "--user", "show", service,
        "-p", "Result", "-p", "ExecMainStatus", "-p", "SubState",
        required=False,
    ).stdout.strip()
finally:
    command("systemctl", "--user", "stop", timer, required=False)
    command("systemctl", "--user", "stop", service, required=False)
    command("systemctl", "--user", "reset-failed", timer, service, required=False)
    for _ in range(30):
        timer_state = command("systemctl", "--user", "show", timer, "-p", "LoadState", "--value", required=False).stdout.strip()
        service_state = command("systemctl", "--user", "show", service, "-p", "LoadState", "--value", required=False).stdout.strip()
        if timer_state != "loaded" and service_state != "loaded":
            break
        time.sleep(0.2)
    report["timer_after_remove"] = timer_state
    report["service_after_remove"] = service_state
    timers = command("systemctl", "--user", "list-timers", "--all", "--no-legend", required=False).stdout
    report["listed_after_remove"] = unit in timers
    (root / "result.json").write_text(json.dumps(report, indent=2) + "\n")
    print(json.dumps(report, indent=2))
    if timer_state == "loaded" or service_state == "loaded" or report["listed_after_remove"]:
        print("FAIL: transient user timer/service residue remains", file=sys.stderr)
        sys.exit(1)

if "fired_utc" not in report:
    raise RuntimeError("fixture did not fire before cleanup")
print("E0_SYSTEMD_QUALIFICATION=3")

