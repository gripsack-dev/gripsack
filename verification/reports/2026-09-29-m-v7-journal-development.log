CLI_SCRIPT
from pathlib import Path
import hashlib
import os
import signal
import subprocess
import sys
import tempfile

sys.path.insert(0, str(Path.cwd()))
from conftest import GRIP, make_env_repo

with tempfile.TemporaryDirectory(prefix='gripsack-journal-authority-cli-') as temporary:
    root = Path(temporary)
    home = root / 'home'
    home.mkdir()
    destination = home / 'setting'
    destination.write_bytes(b'original\n')
    destination.chmod(0o600)
    repo = make_env_repo(root / 'env', '''import { module, trackedCopy } from '@gripsack/core';
export default module('demo', { config: { payload: trackedCopy('~/setting') } });''')
    source = repo / 'payload'
    source.write_bytes(b'first\n')
    state = home / '.local/share/gripsack'
    environment = dict(os.environ, HOME=str(home), GRIPSACK_HOME=str(state), GRIPSACK_TRUST_ALL='1')
    print('BINARY_SHA256=' + hashlib.sha256(GRIP.resolve().read_bytes()).hexdigest(), flush=True)

    def invoke(*arguments, extra=None, expected=0):
        result = subprocess.run([str(GRIP), *arguments], cwd=repo,
                                env={**environment, **(extra or {})},
                                capture_output=True, text=True, timeout=90)
        print('COMMAND=' + ' '.join(arguments), 'EXIT=' + str(result.returncode), flush=True)
        print(result.stdout, result.stderr, flush=True)
        assert result.returncode == expected
        return result

    apply = ('apply', '--host', 'testhost', '--jobs', '1')
    invoke(*apply, '--take-over')
    assert destination.read_bytes() == b'first\n'
    assert destination.stat().st_mode & 0o7777 == 0o600
    first_selection = (state / 'current').readlink()
    source.write_bytes(b'second\n')
    invoke(*apply)
    assert destination.read_bytes() == b'second\n'
    second_selection = (state / 'current').readlink()
    assert first_selection != second_selection
    invoke('rollback', '1', extra={'GRIPSACK_CRASH_AFTER': 'after-rollback-restore'}, expected=-signal.SIGABRT)
    assert destination.read_bytes() == b'first\n'
    assert (state / 'current').readlink() == second_selection
    assert (state / 'journal/run.json').is_file()
    invoke(*apply, extra={'GRIPSACK_FS_RECOVER_ONLY': '1'})
    assert destination.read_bytes() == b'second\n'
    assert (state / 'current').readlink() == second_selection
    assert not list((state / 'journal').glob('*.json'))
    invoke('rollback', '1')
    assert destination.read_bytes() == b'first\n'
    assert (state / 'current').resolve() == state / 'generations/1'
    assert (state / 'current').readlink() not in (first_selection, second_selection)
    invoke(*apply, extra={'GRIPSACK_FS_RECOVER_ONLY': '1'})
    assert destination.read_bytes() == b'first\n'
    assert destination.stat().st_mode & 0o7777 == 0o600
    print('JOURNAL_AUTHORITY_CLI=apply_update_interrupted_rollback_recovery_fresh_selection PASSED', flush=True)

