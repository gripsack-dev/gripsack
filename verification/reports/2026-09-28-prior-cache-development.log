import hashlib
import json
import os
from pathlib import Path
import subprocess
import tempfile

with tempfile.TemporaryDirectory(prefix="gripsack-prior-cache-") as temporary:
    root = Path(temporary)
    repo = root / "repo"
    home = root / "state"
    (repo / "hosts").mkdir(parents=True)
    (repo / "env.toml").write_text('[env]\nname="prior-cache-smoke"\n')
    (repo / "hosts/testhost.ts").write_text('import { defineEnv, module, trackedCopy } from "@gripsack/core";\nexport default defineEnv(() => ({ modules: [module("demo", {config:{source:trackedCopy("~/.cached-prior")}})] }));\n')
    original = b"original captured bytes\n"
    replacement = b"replacement bytes\n"
    source = repo / "source"
    source.write_bytes(original)
    destination = root / ".cached-prior"
    env = dict(os.environ, HOME=str(root), GRIPSACK_HOME=str(home), GRIPSACK_TRUST_ALL="1", NO_COLOR="1")
    def invoke(arguments, extra=None):
        result = subprocess.run(["grip", *arguments], cwd=repo, env={**env, **(extra or {})}, capture_output=True, text=True, timeout=30)
        print("$ grip " + " ".join(arguments), "exit=" + str(result.returncode))
        print(result.stdout + result.stderr)
        return result
    def apply(extra=None):
        return invoke(["apply", "--host", "testhost"], extra)
    assert apply().returncode == 0
    source.write_bytes(replacement)
    assert apply().returncode == 0
    blob = home / "prior" / hashlib.sha256(original).hexdigest()
    assert blob.read_bytes() == original
    assert invoke(["rollback", "1"]).returncode == 0
    trace = root / "boundaries.tsv"
    assert apply({"GRIPSACK_FS_TRACE": str(trace)}).returncode == 0
    rows = [line.split("\t", 3) for line in trace.read_text().splitlines()]
    file_index = next(i for i, row in enumerate(rows) if row[1:] == ["Before", "FileSync", json.dumps(blob.name)])
    parent_index = next(i for i in range(file_index + 1, len(rows)) if rows[i][1:] == ["Before", "DirSync", '"."'])
    results = []
    for boundary, index in [("file", file_index), ("parent", parent_index)]:
        assert invoke(["rollback", "1"]).returncode == 0
        previous = (home / "current").readlink()
        failed = apply({"GRIPSACK_FS_CUT": rows[index][0], "GRIPSACK_FS_FAULT": "error"})
        assert failed.returncode != 0
        assert destination.read_bytes() == original
        assert (home / "current").readlink() == previous
        assert blob.read_bytes() == original
        assert apply().returncode == 0
        assert destination.read_bytes() == replacement
        results.append({"boundary": boundary, "refused_before_destination_write": True, "current_preserved": True, "prior_preserved": True, "retry_deployed": True})
    print("PRIOR_CACHE_SMOKE=" + json.dumps({"cases": results, "power_loss_claim": False, "fuzz": "not_run"}, sort_keys=True))
