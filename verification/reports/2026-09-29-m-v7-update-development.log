from pathlib import Path
import hashlib
import json
import os
import subprocess
import sys
import tempfile

sys.path.insert(0, str(Path.cwd()))
from conftest import GRIP, make_env_repo, make_tarball
from test_update_surveys import store_snapshot

with tempfile.TemporaryDirectory(prefix='gripsack-update-accounting-cli-') as temporary:
    home = Path(temporary)
    os.environ.update(HOME=str(home), GRIPSACK_HOME=str(home / '.local/share/gripsack'), GRIPSACK_TRUST_ALL='1')
    for key in ('XDG_DATA_HOME', 'GH_TOKEN', 'GITHUB_TOKEN', 'GH_HOST', 'GITHUB_HOST',
                'GH_ENTERPRISE_TOKEN', 'GITHUB_ENTERPRISE_TOKEN', 'HTTP_PROXY',
                'HTTPS_PROXY', 'ALL_PROXY', 'http_proxy', 'https_proxy', 'all_proxy'):
        os.environ.pop(key, None)
    os.environ['NO_PROXY'] = '*'
    moving = make_tarball(home / 'moving.tar.gz', {'payload': b'one'})
    recipe_source = make_tarball(home / 'source.tar.gz', {'source': b'recipe input'})
    missing = home / 'missing.tar.gz'
    marker = home / 'recipe-was-executed'
    repo = make_env_repo(home / 'env', {
        'alpha': f"import {{module,fileFetch,trackedCopy}} from '@gripsack/core'; export default module('alpha',{{fetch:fileFetch('{moving}'),install:{{payload:trackedCopy('~/.alpha')}}}});",
        'builder': f"import {{module,fileFetch,symlink,verifyBinary}} from '@gripsack/core'; export default module('builder',{{fetch:fileFetch('{recipe_source}'),build:{{kind:'custom_shell',script:'touch {marker}; cp source built'}},install:{{built:symlink('~/.built')}},verify:verifyBinary('built')}});",
        'plain': "import {module} from '@gripsack/core'; export default module('plain',{});",
        'omega': f"import {{module,fileFetch}} from '@gripsack/core'; export default module('omega',{{fetch:fileFetch('{missing}')}});",
    })
    print('BINARY_SHA256=' + hashlib.sha256(GRIP.resolve().read_bytes()).hexdigest(), flush=True)

    def invoke(expected, *arguments):
        command = [str(GRIP.resolve()), 'update', *arguments, '--host', 'testhost']
        result = subprocess.run(command, cwd=repo, capture_output=True, text=True, timeout=60)
        print('COMMAND=' + json.dumps(command) + ' EXIT=' + str(result.returncode), flush=True)
        print(result.stdout, end='', flush=True)
        print(result.stderr, end='', flush=True)
        assert result.returncode == expected, (expected, result.returncode)
        return result

    invoke(0, 'alpha')
    lock = repo / 'locks/testhost.lock'
    before_lock = lock.read_bytes()
    before_store = store_snapshot(home)
    make_tarball(moving, {'payload': b'two'})
    selected = ('omega', 'alpha', 'plain', 'builder', 'missing-selected', 'missing-selected')
    survey = invoke(2, '--check', *selected)
    rows = [line.strip().split(maxsplit=1) for line in survey.stdout.splitlines()
            if line.startswith('  ') and not line.startswith('    ')]
    observed = {}
    for name, detail in rows:
        observed[name] = next(kind for prefix, kind in (
            ('would bump', 'changed'), ('unchanged', 'unchanged'),
            ('skipped', 'skipped'), ('failed', 'failed'),
        ) if detail.startswith(prefix))
    assert observed == {'alpha': 'changed', 'builder': 'changed', 'plain': 'skipped',
                        'omega': 'failed', 'missing-selected': 'failed'}, observed
    assert len(rows) == 5, rows
    assert lock.read_bytes() == before_lock
    assert store_snapshot(home) == before_store
    assert not marker.exists() and not (home / '.built').exists() and not (home / '.alpha').exists()
    print('COMPLETE_ERROR_DOMINANT_SURVEY=passed reports=5', flush=True)

    invoke(1, *selected)
    assert lock.read_bytes() == before_lock
    assert not marker.exists()
    print('FAILED_PUBLISH_PRESERVES_LOCK=passed', flush=True)

    make_tarball(missing, {'payload': b'repaired'})
    invoke(0, *selected)
    assert set(json.loads(lock.read_bytes())['modules']) == {'alpha', 'builder', 'omega'}
    assert not marker.exists() and not (home / '.built').exists() and not (home / '.alpha').exists()
    print('REPAIRED_PUBLISH_WITHOUT_NATIVE_EFFECTS=passed', flush=True)

    current_bytes = lock.read_bytes() + b' \n'
    lock.write_bytes(current_bytes)
    known = ('alpha', 'builder', 'plain', 'omega')
    invoke(0, '--check', *known)
    invoke(0, *known)
    assert lock.read_bytes() == current_bytes
    assert not marker.exists()
    print('CURRENT_CHECK_AND_PUBLISH_PRESERVE_BYTES=passed', flush=True)
    print('UPDATE_SURVEY_CLI_SMOKES=4', flush=True)


