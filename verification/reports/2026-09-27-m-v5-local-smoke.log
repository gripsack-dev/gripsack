import hashlib
import json
import os
from pathlib import Path
import subprocess
import tempfile

print('SMOKE_SOURCE_SHA256=' + hashlib.sha256(Path(__file__).read_bytes()).hexdigest())
with tempfile.TemporaryDirectory(prefix='gripsack-gc-lifecycle-') as directory:
    root = Path(directory)
    home = root / 'state'
    repo = root / 'repo'
    (repo / 'modules').mkdir(parents=True)
    (repo / 'hosts').mkdir()
    (repo / 'env.toml').write_text('[env]\nname="gc-smoke"\n[settings]\nkeep_generations=1\n')
    (repo / 'modules/demo.ts').write_text('import { module, symlink } from "@gripsack/core";\nexport default module("demo", { install: { payload: symlink("~/.owned") } });\n')
    (repo / 'hosts/testhost.ts').write_text('import { defineEnv } from "@gripsack/core";\nimport demo from "../modules/demo.ts";\nexport default defineEnv(() => ({ modules: [demo] }));\n')
    env = dict(os.environ, HOME=str(root), GRIPSACK_HOME=str(home), GRIPSACK_TRUST_ALL='1', NO_COLOR='1', XDG_CONFIG_HOME=str(root / 'config'), XDG_CACHE_HOME=str(root / 'cache'))
    env.pop('XDG_DATA_HOME', None)
    def run(*args, success=True):
        result = subprocess.run(['grip', *args], cwd=repo, env=env, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=30)
        print('$ grip ' + ' '.join(args))
        print(result.stdout)
        if (result.returncode == 0) != success:
            raise RuntimeError(f'unexpected exit {result.returncode}')
        return result
    for content in ['one', 'two']:
        (repo / 'payload').write_text(content)
        run('apply', '--host', 'testhost')
    manifests = [(home / f'generations/{n}/manifest.json').read_bytes() for n in [1, 2]]
    (home / 'store').rename(home / 'saved-store')
    outside = root / 'outside'
    (outside / 'foreign-directory').mkdir(parents=True)
    sentinel = outside / 'foreign-directory/sentinel'
    sentinel.write_text('foreign fixture')
    (home / 'store').symlink_to(outside, target_is_directory=True)
    for dry_run in [True, False]:
        run('gc', *(['--dry-run'] if dry_run else []), success=False)
        assert sentinel.read_text() == 'foreign fixture'
        assert [(home / f'generations/{n}/manifest.json').read_bytes() for n in [1, 2]] == manifests
    print('SMOKE_ROOT_REFUSAL=2 external_sentinel_retained=true generation_history_unchanged=true')
    (home / 'store').unlink()
    (home / 'saved-store').rename(home / 'store')
    run('rollback', '1')
    assert (root / '.owned').read_text() == 'one'
    orphan = home / 'store/orphan-link'
    orphan.symlink_to(outside, target_is_directory=True)
    run('gc', '--dry-run')
    assert orphan.is_symlink()
    run('gc')
    assert not orphan.is_symlink() and sentinel.read_text() == 'foreign fixture'
    assert (home / 'generations/1/manifest.json').exists()
    assert (home / 'generations/2/manifest.json').exists()
    print('SMOKE_OLD_CURRENT_PROTECTED=true orphan_link_only_removed=true')
    run('rollback', '2')
    run('gc')
    assert not (home / 'generations/1').exists()
    assert (root / '.owned').read_text() == 'two'
    print('SMOKE_EXPIRED_HISTORY_COLLECTED=true current_payload_retained=true')
    (home / 'generations/high-water').write_text(str(2**64 - 1))
    (repo / 'payload').write_text('three')
    run('apply', '--host', 'testhost', success=False)
    assert (root / '.owned').read_text() == 'two'
    assert (home / 'current').readlink() == Path('generations/2')
    print('SMOKE_GENERATION_OVERFLOW_REFUSED=true current_unchanged=true')
    print('SMOKE_RESULT=' + json.dumps({'executed': 5, 'passed': 5, 'failed': 0, 'fuzz': 'not_run_owner_instruction'}, sort_keys=True))


SMOKE_SCRIPT_BYTES_END
