from pathlib import Path
import hashlib
import json
import os
import subprocess
import sys
import tempfile

sys.path.insert(0, str(Path.cwd()))
from conftest import GRIP
from test_http_policy import HttpFixture, tarball_repo

base_environment = dict(os.environ)
with tempfile.TemporaryDirectory(prefix='gripsack-http-budget-cli-') as temporary:
    root = Path(temporary)
    print('BINARY_SHA256=' + hashlib.sha256(GRIP.resolve().read_bytes()).hexdigest(), flush=True)
    for mode, names, expected_code, expected_counts, limited in [
        ('flaky', ('tool',), 1, {'/tool': 3}, False),
        ('always-500', ('tool',), 2, {'/tool': 3}, False),
        ('cooldown', ('alpha', 'omega'), 2, {'/alpha': 1}, False),
        ('partial', ('tool',), 1, {'/tool': 2}, False),
        ('partial', ('tool',), 2, {'/tool': 2}, True),
    ]:
        home = root / (mode + ('-limited' if limited else ''))
        home.mkdir()
        os.environ.clear()
        os.environ.update(base_environment)
        os.environ.update(HOME=str(home), GRIPSACK_HOME=str(home / '.local/share/gripsack'), GRIPSACK_TRUST_ALL='1')
        for variable in ('XDG_DATA_HOME', 'GH_TOKEN', 'GITHUB_TOKEN', 'GH_HOST', 'GITHUB_HOST', 'GH_ENTERPRISE_TOKEN', 'GITHUB_ENTERPRISE_TOKEN', 'ALL_PROXY', 'all_proxy', 'HTTP_PROXY', 'http_proxy', 'HTTPS_PROXY', 'https_proxy'):
            os.environ.pop(variable, None)
        os.environ['NO_PROXY'] = '*'
        server = HttpFixture()
        try:
            server.mode = mode
            repo = tarball_repo(home, server, names)
            if limited:
                with (repo / 'env.toml').open('a') as config:
                    config.write(f'\n[settings]\ndownload_limit_bytes = {len(server.archive)}\n')
            result = subprocess.run([str(GRIP.resolve()), 'update', '--check', '--host', 'testhost'], cwd=repo, capture_output=True, text=True, timeout=30)
            print('COMMAND', str(GRIP.resolve()), 'update --check --host testhost', 'MODE', mode, 'LIMITED', limited, 'EXIT', result.returncode, flush=True)
            print(result.stdout, end='', flush=True)
            print(result.stderr, end='', flush=True)
            assert result.returncode == expected_code
            assert dict(server.counts) == expected_counts, dict(server.counts)
            assert not (repo / 'locks/testhost.lock').exists()
            assert not (home / '.local/share/gripsack/store').exists()
            print('OBSERVED_REQUESTS=' + json.dumps(dict(server.counts), sort_keys=True), flush=True)
        finally:
            server.close()
print('HTTP_BUDGET_CLI_SMOKE=5', flush=True)


