from pathlib import Path
import hashlib
import json
import os
import subprocess
import sys
import tempfile

sys.path.insert(0, str(Path.cwd()))
from conftest import GRIP, make_env_repo
from test_fetchers import FETCH_FIXTURE, PLUGIN_MODULES

base_environment = dict(os.environ)

def prepare(root, rate, count):
    home = root / 'home'
    home.mkdir()
    state = home / '.local/share/gripsack'
    tools = root / 'tools'
    tools.mkdir()
    calls = root / 'calls.jsonl'
    fixture = FETCH_FIXTURE.replace('"1/s"', json.dumps(rate)).replace(
        'elif req["op"] == "fetch":\n',
        'elif req["op"] == "fetch":\n'
        '    import time\n'
        f'    with open({str(calls)!r}, "a") as record: record.write(json.dumps({{"time": time.monotonic_ns()}}) + "\\n")\n',
    )
    fetcher = tools / 'gripfetch-demo'
    fetcher.write_text(fixture)
    fetcher.chmod(0o755)
    os.environ.clear()
    os.environ.update(base_environment)
    os.environ.update(HOME=str(home), GRIPSACK_HOME=str(state), GRIPSACK_TRUST_ALL='1', PATH=str(tools) + ':' + base_environment['PATH'])
    os.environ.pop('XDG_DATA_HOME', None)
    modules = {name: PLUGIN_MODULES['a'].replace('module("a"', f'module("{name}"').replace('demo-a', f'demo-{name}') for name in 'abcd'[:count]}
    repo = make_env_repo(root / 'repo', modules)
    config = repo / 'env.toml'
    config.write_text(config.read_text() + '\n[throttle]\n"demo.local" = ' + json.dumps(rate) + '\n')
    return home, state, calls, repo

def apply(repo):
    result = subprocess.run([str(GRIP.resolve()), 'apply', '--host', 'testhost'], cwd=repo, capture_output=True, text=True, timeout=30)
    print('COMMAND', str(GRIP.resolve()), 'apply --host testhost', 'CWD', repo, 'EXIT', result.returncode, flush=True)
    print(result.stdout, end='', flush=True)
    print(result.stderr, end='', flush=True)
    return result.returncode

with tempfile.TemporaryDirectory(prefix='gripsack-rate-cli-') as temporary:
    root = Path(temporary)
    print('BINARY_SHA256=' + hashlib.sha256(GRIP.resolve().read_bytes()).hexdigest(), flush=True)
    for label, rate in [('fractional', '1.5/s'), ('largest', '1.7976931348623157e308/s')]:
        case = root / label
        case.mkdir()
        home, state, calls, repo = prepare(case, rate, 4)
        assert apply(repo) == 0
        events = [json.loads(line) for line in calls.read_text().splitlines()]
        assert len(events) == 4, events
        for name in 'abcd':
            assert (home / f'.local/bin/demo-{name}').read_text() == '#!/bin/sh\necho demo\n'
        saved = json.loads((state / 'throttle.json').read_text())['demo.local']
        assert saved['version'] == 1 and saved['period_ns'] == 1_000_000_000
        spacing = (max(event['time'] for event in events) - min(event['time'] for event in events)) / 1e9
        if label == 'fractional':
            assert spacing >= 1.5, spacing
        print(f'OBSERVED {label}: four actual plugin fetches, installed payloads, persisted exact credits, invocation spacing {spacing:.6f}s', flush=True)
    case = root / 'persisted-deadline'
    case.mkdir()
    home, state, calls, repo = prepare(case, '1.5/hr', 2)
    assert apply(repo) == 1
    assert len(calls.read_text().splitlines()) == 1
    assert apply(repo) == 1
    assert len(calls.read_text().splitlines()) == 1
    config = repo / 'env.toml'
    config.write_text(config.read_text().replace('"1.5/hr"', '"100/s"'))
    assert apply(repo) == 0
    for name in 'ab':
        assert (home / f'.local/bin/demo-{name}').read_text() == '#!/bin/sh\necho demo\n'
    print('OBSERVED persisted-deadline: insufficient tokens refused both commands without another fetch; explicit higher-rate override recovered both payloads', flush=True)
print('RATE_CLI_SMOKE=3', flush=True)


