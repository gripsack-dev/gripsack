import json
import os
from pathlib import Path
import sqlite3
import subprocess
import tempfile

examples = Path('/examples')
with tempfile.TemporaryDirectory(prefix='gripsack-example-smoke-') as temporary:
    root = Path(temporary)
    environment = dict(os.environ, HOME=str(root), NO_PROXY='127.0.0.1,localhost', no_proxy='127.0.0.1,localhost')
    def invoke(script, *args, token='a'*64, success=True):
        result = subprocess.run(['python', str(examples/script), *map(str,args)],
            env={**environment, 'GRIPSACK_ACTIVATION_INTENT_ID':token}, capture_output=True, text=True, timeout=15)
        print('$', script, *args, 'exit='+str(result.returncode))
        print(result.stdout or result.stderr)
        assert (result.returncode == 0) == success
        return json.loads(result.stdout) if result.stdout.strip() else None
    output = root/'derived'
    invoke('atomic_replace.py', output, '--value', 'stable bytes')
    invoke('atomic_replace.py', output, '--value', 'stable bytes')
    assert output.read_bytes() == b'stable bytes'
    assert output.stat().st_mode & 0o777 == 0o600
    state = root/'local'
    first = invoke('keyed_increment.py','--state-dir',state)
    repeated = invoke('keyed_increment.py','--state-dir',state)
    second = invoke('keyed_increment.py','--state-dir',state,token='b'*64)
    assert (first['value'],first['applied'],repeated['value'],repeated['applied'],second['value']) == (1,True,1,False,2)
    invoke('keyed_increment.py','--state-dir',state,'--counter','wrong-payload',success=False)
    assert state.stat().st_mode & 0o777 == 0o700
    assert (state/'counter.sqlite').stat().st_mode & 0o777 == 0o600
    with sqlite3.connect(state/'counter.sqlite') as connection:
        assert connection.execute('SELECT name,value FROM counters').fetchall() == [('example',2)]
    remote = root/'remote'
    def server():
        process = subprocess.Popen(['python',str(examples/'receiver.py'),'--state-dir',str(remote),'--port','0'],
            env=environment,stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True)
        line = process.stdout.readline().strip()
        assert line.startswith('LISTEN_PORT='), line
        return process, 'http://127.0.0.1:'+line.split('=',1)[1]+'/increment'
    process, endpoint = server()
    try:
        before = invoke('notify.py','--endpoint',endpoint,token='c'*64)
        assert before['value'] == 1 and before['applied']
    finally:
        process.kill(); process.wait(timeout=5)
    process, endpoint = server()
    try:
        after = invoke('notify.py','--endpoint',endpoint,token='c'*64)
        assert after['value'] == 1 and not after['applied']
    finally:
        process.terminate(); process.wait(timeout=5)
    with sqlite3.connect(remote/'counter.sqlite') as connection:
        assert connection.execute('SELECT value FROM counters').fetchall() == [(1,)]
        assert connection.execute('SELECT COUNT(*) FROM receipts').fetchone() == (1,)
    print('HOOK_EXAMPLE_SMOKE='+json.dumps({'atomic_replace':'same bytes', 'local_distinct_effects':2,
        'local_duplicate_effects':1, 'payload_reuse':'refused', 'receiver_after_process_restart':1},sort_keys=True))
