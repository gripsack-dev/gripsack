{
  "name": "@gripsack/core",
  "version": "0.1.0",
  "description": "gripsack typescript frontend — typed module DSL, emits IR",
  "license": "MIT",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": ["dist/src"],
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test dist/test/*.test.js"
  },
  "keywords": ["dotfiles", "package-manager", "environment"],
  "homepage": "https://gripsack.dev",
  "repository": "https://github.com/gripsack-dev/gripsack",
  "engines": { "node": ">=18" },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5"
  }
}
