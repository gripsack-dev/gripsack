    },
    "core": {
      "crate": "gripsack",
      "binary": "grip",
      "version": "0.46.1",
      "target": "x86_64-unknown-linux-musl"
    },
    "helper": {
      "crate": "gripsack-conda",
      "version": "0.46.1",
      "target": "x86_64-unknown-linux-musl"
    },
    "bridge": {
      "binary": "grip-buildkit-bridge",
      "version": "0.46.1",
      "target": "x86_64-unknown-linux-musl"
    },
    "ir_version": 7,
    "fuzz_exclusion": "REL-FUZZ-2026-09-27",
    "authority": "local nonpublishing reviewed-code qualification; ordinary Actions remain authoritative",
    "buildkit_cache": "retained; build output records cache hits, not fresh RUN execution",
    "persistence_budget": {
      "partitions": 96,
      "shards": 8,
      "drift_states": [
        false,
        true
      ],
      "maximum_slots": 8,
      "slot_cpus": 1,
      "slot_memory_bytes": 2147483648,
      "partition_timeout_seconds": 7200,
      "outer_timeout_seconds": 0,
      "slots_environment": "GRIPSACK_PERSISTENCE_SLOTS; 1..min(8, measured Docker NCPU, measured Docker MemTotal / 2 GiB)"
    },
    "persistence_checkpoints": {
      "candidate_environment": "CI_CANDIDATE_ID",
      "root_environment": "CI_CHECKPOINT_ROOT",
      "authority": "CI-owned candidate/gate subtree; partition checkpoints are not controller gate-success receipts",
      "admission": "candidate/source/image/dispatcher-bound exit-zero report and log digests, followed by original full96 union admission",
      "retained_log_bytes_per_partition": 16777216,
      "metadata_bytes_per_file": 65536,
      "fixtures": "never retained; private container filesystem only",
      "timing": "original boot-ID-bound monotonic nanoseconds; UTC observations are informational; ambiguous unfinished timing after boot changes expires without a fresh budget",
      "resume": "reuse admitted completed partitions; reattach matching journalled containers without resetting deadlines; restart only unfinished boundaries on a new operator invocation"
    },
    "excluded_platforms": [
      "linux-aarch64",
      "macos",
      "native-windows"
    ],
    "hardware_claim": "none; Linux process-fault persistence is not power-loss qualification"
  }
}
