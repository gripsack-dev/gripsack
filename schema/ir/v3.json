{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gripsack.dev/schema/ir/v3.json",
  "title": "gripsack IR v3",
  "description": "Typed frontend/core contract, aligned with the core's structural acceptance: deny-unknown structs plus the tagged-field pass (parse + pass 1.5). Unknown structural fields are rejected; optional fields may be explicit null (serde Option); integers are Rust u32 (spans). Semantic checks (graph, path and phase relationships) live in sema, not here. Authored-value constraints retained from the shipped v3 contract (sha256 hex, destination prefix, repo shape, minLength) are tighter than the parser on purpose: they constrain what a frontend may author, and only bound fields the parser also bound are claimed as parity.",
  "type": "object",
  "required": [
    "ir_version",
    "modules"
  ],
  "additionalProperties": false,
  "properties": {
    "ir_version": {
      "const": 3
    },
    "host": {
      "$ref": "#/$defs/hostFacts"
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      },
      "description": "Declared resources (0007 §4); step resources must resolve to these or core built-ins"
    },
    "modules": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/module"
      }
    }
  },
  "$defs": {
    "hostFacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "os": {
          "type": "string"
        },
        "arch": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "libc": {
          "type": ["string", "null"],
          "description": "e.g. glibc-2.36, musl, darwin; null or absent when undetectable"
        }
      }
    },
    "span": {
      "type": "object",
      "required": [
        "file",
        "line"
      ],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "col": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "description": "Source location of this node in frontend code (plan/0004 §2). Optional; built-in frontends MUST emit it at module level. line/col are Rust u32."
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fetch": {
          "anyOf": [
            { "$ref": "#/$defs/fetch" },
            { "type": "null" }
          ]
        },
        "build": {
          "$ref": "#/$defs/build"
        },
        "install": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          }
        },
        "config": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          }
        },
        "depends": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependency"
          }
        },
        "activate": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/intent"
          }
        },
        "steps": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/step"
              }
            },
            { "type": "null" }
          ],
          "description": "Explicit pipeline control (0007): present means the declarative fields above must all be empty (sema E103)"
        },
        "verify": {
          "anyOf": [
            { "$ref": "#/$defs/verify" },
            { "type": "null" }
          ]
        },
        "lint": {
          "type": ["string", "null"],
          "description": "Registered linter for this module's config payloads (0011); the core drives it (0012)"
        },
        "env": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/envVar"
          },
          "description": "Environment contributions exported to the shell profile at activation (plan/0001 §3.10)"
        },
        "span": {
          "anyOf": [
            { "$ref": "#/$defs/span" },
            { "type": "null" }
          ]
        }
      }
    },
    "build": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "none",
            "custom_shell"
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": { "const": "none" }
          },
          "required": ["kind"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "custom_shell" },
            "script": { "type": "string" }
          },
          "required": ["kind", "script"],
          "additionalProperties": false
        }
      ]
    },
    "entry": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "pattern": "^(/|~/)",
          "description": "absolute or ~/-prefixed destination"
        },
        "mode": {
          "enum": [
            "owned",
            "tracked_copy",
            "merge",
            "template"
          ],
          "default": "owned"
        },
        "vars": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "template variables (mode template only)"
        },
        "marker": {
          "type": ["string", "null"],
          "description": "comment prefix for the managed block (mode merge only); default: inferred from the dest extension"
        },
        "span": {
          "anyOf": [
            { "$ref": "#/$defs/span" },
            { "type": "null" }
          ]
        }
      }
    },
    "dependency": {
      "type": "object",
      "required": [
        "module"
      ],
      "properties": {
        "module": {
          "type": "string",
          "minLength": 1
        },
        "for": {
          "enum": [
            "runtime",
            "build"
          ],
          "default": "runtime",
          "description": "Build dependencies provide store artifacts to build steps; runtime dependencies also deploy. Runtime incoming edges win over build-only use (0039)."
        },
        "span": {
          "anyOf": [
            { "$ref": "#/$defs/span" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "intent": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "trigger": {
          "enum": [
            "post_link",
            "post_activate",
            "on_remove"
          ],
          "default": "post_activate"
        },
        "kind": {
          "enum": [
            "service",
            "fonts",
            "desktop_entry",
            "custom_shell"
          ]
        },
        "name": {
          "type": "string"
        },
        "user": {
          "type": "boolean"
        },
        "script": {
          "type": "string"
        },
        "span": {
          "anyOf": [
            { "$ref": "#/$defs/span" },
            { "type": "null" }
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": { "const": "service" },
            "name": { "type": "string" },
            "user": { "type": "boolean" },
            "trigger": { "$ref": "#/$defs/trigger" },
            "span": {
              "anyOf": [
                { "$ref": "#/$defs/span" },
                { "type": "null" }
              ]
            }
          },
          "required": ["kind", "name"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "fonts" },
            "trigger": { "$ref": "#/$defs/trigger" },
            "span": {
              "anyOf": [
                { "$ref": "#/$defs/span" },
                { "type": "null" }
              ]
            }
          },
          "required": ["kind"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "desktop_entry" },
            "trigger": { "$ref": "#/$defs/trigger" },
            "span": {
              "anyOf": [
                { "$ref": "#/$defs/span" },
                { "type": "null" }
              ]
            }
          },
          "required": ["kind"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "custom_shell" },
            "script": { "type": "string" },
            "trigger": { "$ref": "#/$defs/trigger" },
            "span": {
              "anyOf": [
                { "$ref": "#/$defs/span" },
                { "type": "null" }
              ]
            }
          },
          "required": ["kind", "script"],
          "additionalProperties": false
        }
      ]
    },
    "trigger": {
      "enum": [
        "post_link",
        "post_activate",
        "on_remove"
      ],
      "default": "post_activate"
    },
    "resource": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "step": {
      "type": "object",
      "required": [
        "id",
        "action"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "$ref": "#/$defs/stepAction"
        },
        "needs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "sibling step ids or cross-module 'module:step' refs"
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "phase": {
          "anyOf": [
            { "$ref": "#/$defs/phase" },
            { "type": "null" }
          ]
        },
        "verify": {
          "anyOf": [
            { "$ref": "#/$defs/verify" },
            { "type": "null" }
          ]
        },
        "span": {
          "anyOf": [
            { "$ref": "#/$defs/span" },
            { "type": "null" }
          ]
        }
      }
    },
    "stepAction": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "fetch",
            "build",
            "install",
            "config_deploy",
            "intent",
            "verify",
            "run",
            "custom_shell"
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": { "const": "fetch" },
            "fetch": { "$ref": "#/$defs/fetch" }
          },
          "required": ["kind", "fetch"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "build" },
            "spec": { "$ref": "#/$defs/build" }
          },
          "required": ["kind", "spec"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "install" },
            "entries": {
              "type": "array",
              "items": { "$ref": "#/$defs/entry" }
            }
          },
          "required": ["kind", "entries"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "config_deploy" },
            "entries": {
              "type": "array",
              "items": { "$ref": "#/$defs/entry" }
            }
          },
          "required": ["kind", "entries"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "intent" },
            "action": { "$ref": "#/$defs/action" },
            "trigger": { "$ref": "#/$defs/trigger" }
          },
          "required": ["kind", "action"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "verify" },
            "verify": { "$ref": "#/$defs/verify" }
          },
          "required": ["kind", "verify"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "run" },
            "argv": {
              "type": "array",
              "items": { "type": "string" }
            },
            "env": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "cwd": { "type": ["string", "null"] },
            "outputs": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "required": ["kind", "argv"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "custom_shell" },
            "script": { "type": "string" },
            "outputs": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "required": ["kind", "script"],
          "additionalProperties": false
        }
      ]
    },
    "action": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "service",
            "fonts",
            "desktop_entry",
            "custom_shell"
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": { "const": "service" },
            "name": { "type": "string" },
            "user": { "type": "boolean" }
          },
          "required": ["kind", "name"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "fonts" }
          },
          "required": ["kind"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "desktop_entry" }
          },
          "required": ["kind"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "custom_shell" },
            "script": { "type": "string" }
          },
          "required": ["kind", "script"],
          "additionalProperties": false
        }
      ]
    },
    "phase": {
      "enum": [
        "fetch",
        "build",
        "install",
        "config",
        "verify",
        "activate",
        "custom"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fetch": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "github_release",
            "tarball",
            "git",
            "file",
            "plugin",
            "brew",
            "pixi"
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": { "const": "github_release" },
            "repo": {
              "type": "string",
              "pattern": "^[^/]+/[^/]+$"
            },
            "asset": {
              "type": "string"
            },
            "version": {
              "type": ["string", "null"]
            },
            "sha256": {
              "anyOf": [
                { "$ref": "#/$defs/sha256" },
                { "type": "null" }
              ]
            },
            "base_url": {
              "type": ["string", "null"],
              "format": "uri"
            }
          },
          "required": [
            "kind",
            "repo",
            "asset"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "tarball" },
            "url": {
              "type": "string"
            },
            "sha256": {
              "anyOf": [
                { "$ref": "#/$defs/sha256" },
                { "type": "null" }
              ]
            },
            "api_url": {
              "type": ["string", "null"],
              "description": "registry API asset endpoint (authenticated download path); produced by resolution, never written by frontends"
            }
          },
          "required": [
            "kind",
            "url"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "git" },
            "url": {
              "type": "string"
            },
            "rev": {
              "type": ["string", "null"],
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "url"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "file" },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "plugin" },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "args": {
              "anyOf": [
                { "type": "object" },
                { "type": "null" }
              ],
              "description": "plugin-defined; the parser admits any JSON value here, the authored contract is an object (or absent/null)"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "brew" },
            "formula": {
              "type": "string"
            },
            "version": {
              "type": ["string", "null"]
            },
            "sha256": {
              "anyOf": [
                { "$ref": "#/$defs/sha256" },
                { "type": "null" }
              ]
            }
          },
          "required": [
            "kind",
            "formula"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "pixi" },
            "package": {
              "type": "string"
            },
            "version": {
              "type": ["string", "null"]
            },
            "sha256": {
              "anyOf": [
                { "$ref": "#/$defs/sha256" },
                { "type": "null" }
              ]
            }
          },
          "required": [
            "kind",
            "package"
          ],
          "additionalProperties": false
        }
      ]
    },
    "verify": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "binary_runs",
            "file_exists",
            "shell",
            "file_deployed"
          ]
        },
        "path": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "script": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": { "const": "binary_runs" },
            "path": { "type": "string" },
            "args": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "required": ["kind", "path"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "file_exists" },
            "path": { "type": "string" }
          },
          "required": ["kind", "path"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "shell" },
            "script": { "type": "string" }
          },
          "required": ["kind", "script"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "file_deployed" },
            "path": { "type": "string" }
          },
          "required": ["kind", "path"],
          "additionalProperties": false
        }
      ],
      "description": "Smoke contract (0007): binary_runs {path,args} | file_exists {path} | shell {script} | file_deployed {path}. Runs pre-flip."
    },
    "envVar": {
      "type": "object",
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "variable name; PATH-style list vars use prepend/append"
        },
        "op": {
          "enum": [
            "set",
            "prepend",
            "append"
          ],
          "default": "set"
        },
        "value": {
          "type": "string",
          "description": "`{store}` resolves to the module's store path"
        }
      },
      "additionalProperties": false
    }
  }
}
