/-- [gripsack_kernel::journal::{gripsack_kernel::journal::RecordPublication}::acknowledge]:
    Source: 'crates/gripsack-kernel/src/journal.rs', lines 98:4-105:5
    Visibility: public -/
def journal.RecordPublication.acknowledge
  (self : journal.RecordPublication) (action : journal.PublicationAction)
  (succeeded : Bool) :
  Result (Bool × journal.RecordPublication)
  := do
  if succeeded
  then
    let b ← journal.PublicationAction.same action self.next
    if b
    then
      let pa ← journal.PublicationAction.successor action
      let b1 ←
        journal.PublicationAction.same pa journal.PublicationAction.Refused
      ok (¬ b1, { self with next := pa })
    else ok (false, { self with next := journal.PublicationAction.Refused })
  else ok (false, { self with next := journal.PublicationAction.Refused })

