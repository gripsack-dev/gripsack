/-- [gripsack_kernel::generation::strictly_ascending]: loop body 0:
    Source: 'crates/gripsack-kernel/src/generation.rs', lines 66:4-73:1
    Visibility: public -/
@[rust_loop_body]
def generation.strictly_ascending_loop.body
  (ids : Slice generation.GenerationId) (i : Std.Usize) :
  Result (ControlFlow Std.Usize Bool)
  := do
  let i1 := Slice.len ids
  if i < i1
  then
    let i2 ← i - 1#usize
    let gi ← Slice.index_usize ids i2
    let gi1 ← Slice.index_usize ids i
    if gi.number >= gi1.number
    then ok (done false)
    else let i3 ← i + 1#usize
         ok (cont i3)
  else ok (done true)

